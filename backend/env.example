# XOXOPAY Backend Environment Variables

# Database
XOXOPAY_DATABASE__URL=postgres://username:password@localhost/xoxopay

# Server
XOXOPAY_PORT=3000

# JWT Configuration
XOXOPAY_JWT__SECRET=your-super-secret-jwt-key-change-this-in-production
XOXOPAY_JWT__EXPIRATION_HOURS=24
XOXOPAY_JWT__REFRESH_EXPIRATION_HOURS=168

# Stellar Network Configuration
XOXOPAY_STELLAR__NETWORK__PASSPHRASE=Test SDF Network ; September 2015
XOXOPAY_STELLAR__NETWORK__HORIZON_URL=https://horizon-testnet.stellar.org
XOXOPAY_STELLAR__NETWORK__RPC_URL=https://soroban-testnet.stellar.org

# Anchor Configuration
XOXOPAY_ANCHOR__SEP24_URL=https://your-anchor.com/sep24
XOXOPAY_ANCHOR__SEP31_URL=https://your-anchor.com/sep31
XOXOPAY_ANCHOR__WEBHOOK_SECRET=your-webhook-secret
XOXOPAY_ANCHOR__KYC_REQUIRED=true

# Bridge Configuration
XOXOPAY_BRIDGE__ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
XOXOPAY_BRIDGE__POLYGON_RPC_URL=https://polygon-rpc.com
XOXOPAY_BRIDGE__BSC_RPC_URL=https://bsc-dataseed.binance.org
XOXOPAY_BRIDGE__SUPPORTED_ASSETS=["USDC", "USDT"]
XOXOPAY_BRIDGE__MIN_BRIDGE_AMOUNT=1000000
XOXOPAY_BRIDGE__MAX_BRIDGE_AMOUNT=100000000

# Compliance Configuration
XOXOPAY_COMPLIANCE__SANCTIONS_API_URL=https://api.sanctions.example.com
XOXOPAY_COMPLIANCE__SANCTIONS_API_KEY=your-api-key
XOXOPAY_COMPLIANCE__VELOCITY_LIMITS__DAILY_TRANSACTION_LIMIT=10000000
XOXOPAY_COMPLIANCE__VELOCITY_LIMITS__MONTHLY_TRANSACTION_LIMIT=100000000
XOXOPAY_COMPLIANCE__VELOCITY_LIMITS__MAX_TRANSACTION_AMOUNT=5000000
XOXOPAY_COMPLIANCE__RISK_THRESHOLDS__HIGH_RISK_AMOUNT=10000000
XOXOPAY_COMPLIANCE__RISK_THRESHOLDS__MEDIUM_RISK_AMOUNT=1000000

# Rate Limit Configuration
XOXOPAY_RATE__LIMIT__WINDOW_MS=60000
XOXOPAY_RATE__LIMIT__MAX_REQUESTS=100
XOXOPAY_RATE__LIMIT__SCOPE=IP

# Environment
RUN_ENV=development